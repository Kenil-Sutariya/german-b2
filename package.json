{
  "name": "kenils-german-roadmap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:test": "next start --port 4173",
    "test": "npm run typecheck && npm run validate:content && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
