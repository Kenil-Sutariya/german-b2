    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "auth:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
