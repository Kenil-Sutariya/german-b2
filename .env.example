# Vercel adds this automatically when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_WITH_YOUR_STORE_TOKEN

# Generate with: npm run auth:hash -- "your private password"
SITE_PASSWORD_HASH=$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
