# Neon/PostgreSQL connection string. Vercel can inject this when you connect Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: npm run auth:hash -- "your private password"
SITE_PASSWORD_HASH=$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
